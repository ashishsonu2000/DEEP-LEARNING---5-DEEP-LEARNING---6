<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <!-- The bundled demo records are dated; pin the clock so the sample school always
         looks current. Clear the value to use the real system date. -->
    <add key="EazyEdu:SimulatedToday" value="" />

    <!-- Chat requests allowed per user per minute. -->
    <add key="EazyEdu:RateLimitPerMinute" value="40" />

    <!-- Optional generative fallback for questions the rule engine cannot classify.
         Leave the key empty and the assistant stays fully offline and rule-driven.
         Models: claude-opus-5 (most capable), claude-sonnet-5 (balanced, default). -->
    <add key="EazyEdu:AiApiKey" value="" />
    <add key="EazyEdu:AiEndpoint" value="https://api.anthropic.com/v1/messages" />
    <add key="EazyEdu:AiModel" value="claude-sonnet-5" />
    <add key="EazyEdu:AiMaxTokens" value="400" />
    <add key="EazyEdu:AiTimeoutMs" value="8000" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="4096" requestValidationMode="4.5" />
    <globalization culture="en-IN" uiCulture="en-IN" fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <pages validateRequest="true" enableViewStateMac="true" />

    <authentication mode="Forms">
      <forms name=".EAZYEDUAUTH"
             loginUrl="~/Login.aspx"
             defaultUrl="~/Default.aspx"
             protection="All"
             timeout="60"
             slidingExpiration="true"
             cookieless="UseCookies"
             requireSSL="false" />
    </authentication>

    <authorization>
      <deny users="?" />
    </authorization>

    <sessionState mode="InProc" timeout="60" cookieless="UseCookies" />

    <customErrors mode="RemoteOnly" defaultRedirect="~/Login.aspx" />

    <httpCookies httpOnlyCookies="true" requireSSL="false" />
  </system.web>

  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- The analytics dashboard is school-office only. -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="false" />
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <security>
      <requestFiltering>
        <!-- App_Data holds the chat log and tickets; never serve it. -->
        <hiddenSegments>
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>

</configuration>
